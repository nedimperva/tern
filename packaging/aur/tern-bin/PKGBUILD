# Built from the release's .deb. packaging/aur/bump.sh sets the version and checksums;
# see packaging/aur/README.md for publishing to the AUR.

pkgname=tern-bin
pkgver=0.3.2
pkgrel=1
pkgdesc='Fast, local-first, keyboard-first mail client for IMAP'
arch=('x86_64')
url='https://github.com/nedimperva/tern'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsecret' 'libayatana-appindicator' 'hicolor-icon-theme')
optdepends=('gnome-keyring: keeps passwords through the Secret Service (or any other provider, such as KWallet)')
provides=('tern')
conflicts=('tern')
options=('!strip' '!debug')
source=("Tern_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/Tern_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/nedimperva/tern/v${pkgver}/LICENSE")
sha256sums=('cfad9609e775e88116f66bd58086830b6cb84bb8879632b93df144c657957341'
            '3a272cff53901b899da45738174654ca1773af90a0d2bfff6f7b2d4b1fe2df3c')

package() {
  bsdtar -xf data.tar.gz -C "${pkgdir}" --no-same-owner
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
